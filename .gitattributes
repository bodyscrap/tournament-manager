# Auto detect text files and normalize line endings to LF
* text=auto

# Explicitly set CRLF for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Ensure all other text files use LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=js
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.rs text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
